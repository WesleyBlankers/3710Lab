// Memory initialization assignmnents for bram.
// NOTE: All @N indices require hexadecimal format. As shown below.
0000_0000_0000_0000   		// This is address 0. 	Value = 0.
0000_0000_0000_0001   		// This is address 1. 	Value = 1.
@25 0000_0000_0010_0101   	// This is address 37. 	Value = 37.
@26 0000_0000_0010_0110   	// This is address 38. 	Value = 38.
@3FD 0000_0000_0000_1111	// This is address 1021. 	Value = 15.
@3FE 0000_0000_0001_1111	// This is address 1022. 	Value = 31.
@3FF 0000_0000_0011_1111	// This is address 1023. 	Value = 63.

