// Initialize R1 - R4.
1101_0001_0000_0001 // MOVI R1, 1; 		R1 = 1
1101_0010_0000_0010 // MOVI R2, 2; 		R2 = 2
1101_0011_0000_0011 // MOVI R3, 3; 		R3 = 3
1101_0100_0000_0100 // MOVI R4, 4; 		R4 = 4

1101_0000_0100_0000 // MOVI R0, 64; 		R0 = 64 Using this register to hold RAddress

// Store the first 4 register values from R1 to R4 at address R0 = 64
0100_0001_0100_0000 // STOR R1, R0;		BRAM[64] = 1
0110_0000_0000_0001 // ADDUI 1, R0;		R0 = 65
0100_0010_0100_0000 // STOR R2, R0;		BRAM[65] = 2
0110_0000_0000_0001 // ADDUI 1, R0;		R0 = 66
0100_0011_0100_0000 // STOR R3, R0;		BRAM[66] = 3
0110_0000_0000_0001 // ADDUI 1, R0;		R0 = 67
0100_0100_0100_0000 // STOR R4, R0;		BRAM[67] = 4
0110_0000_0000_0001 // ADDUI 1, R0;		R0 = 68

// Modify R1 - R4
1101_0001_0000_0100 // MOVI R1, 4; 		R1 = 4
1101_0010_0000_0011 // MOVI R2, 3; 		R2 = 3
1101_0011_0000_0010 // MOVI R3, 2; 		R3 = 2
1101_0100_0000_0001 // MOVI R4, 1; 		R4 = 1

// Initialize R5 - R8
1101_0101_0000_0001 // MOVI R5, 1; 		R5 = 1
1101_0110_0000_0010 // MOVI R6, 2; 		R6 = 2
1101_0111_0000_0011 // MOVI R7, 3; 		R7 = 3
1101_1000_0000_0100 // MOVI R8, 4; 		R8 = 4

// Return R0 to base address of Stored Array.
1001_0000_0000_0100 // SUBI 4, R0; 		R0 = 64

// Load the data stored into the last 4 registers R12 - R15
0100_1100_0000_0000 // LOAD R12, R0;       R12 = 1;
0110_0000_0000_0001 // ADDUI 1, R0;        R0 = 65
0100_1101_0000_0000 // LOAD R13, R0;       R13 = 2;
0110_0000_0000_0001 // ADDUI 1, R0;        R0 = 66
0100_1110_0000_0000 // LOAD R14, R0;       R14 = 3;
0110_0000_0000_0001 // ADDUI 1, R0;        R0 = 67
0100_1111_0000_0000 // LOAD R15, R0;       R15 = 4;
0110_0000_0000_0001 // ADDUI 1, R0;        R0 = 68

// Output
// R0 = 68
// R1 = 4
// R2 = 3
// R3 = 2
// R4 = 1
// R5 = 1
// R6 = 2
// R7 = 3
// R8 = 4
// R9 = 0
// R10 = 0
// R11 = 0
// R12 = 1
// R13 = 2
// R14 = 3
// R15 = 4


