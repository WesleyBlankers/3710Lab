// Flags:
// Flags[4] = C (Carry)
// Flags[3] = L (Less-than unsigned)
// Flags[2] = F (Overflow)
// Flags[1] = Z (Zero)
// Flags[0] = N (Negative / less-than signed)

1101_0000_0000_0011 // MOVI R0, 3; 	R0 = 3
1000_0000_0000_1000 // LSHI 8, 	R0;	R0 = 768
0101_0000_0010_0000 // ADDI R0, 32; 	R0 = 800   

// Load from address R0 = 800.
0100_0001_0000_0000 // LOAD R1, R0;     R1 = 250 
0110_0000_0000_0001 // ADDUI 1, R0;     R0 = 801
0100_0010_0000_0000 // LOAD R2, R0;     R2 = 252

0110_0011_0101_1010 // ADDUI 90, R3;	R3 = 90

0000_0001_0101_0010 // ADD R1, R2; 	R1 = 502
0000_0001_1011_0010 // CMP R1, R2;	Flags [00000]
0100_0001_1100_0011 // JCond R3; 	IF NOT EQUAL (Z = 0), Jump to address 90.

//These instructions should not run! 
0110_0100_0000_1010 // ADDUI 10, R4;	R4 = 10
0110_0110_0000_0000 // ADDUI 0, R6;     R6 = 0
0100_0100_0100_0110 // STOR R4, R6;     BRAM[0] = 10

@5A // Address 90.
0110_0100_0000_0010 // ADDUI R4, 2;	R4 = 2
0110_0101_0000_0011 // ADDUI R5, 3;     R5 = 3
0000_0100_0101_0101 // ADD R4, R5;	R4 = 5
0000_0001_1001_0100 // SUB R4, R1; 	R1 = -497

// Perform a register swap using the BRAM.
// Store into address R0 = 200.
1101_0000_1100_1000 // MOVI R0, 200;	R0 = 200
0100_0100_0100_0000 // STOR R4, R0;	BRAM[200] = 5
0110_0000_0000_0001 // ADDUI R0, 1;	R0 = 201
0100_0101_0100_0000 // STOR R5, R0;	BRAM[201] = 3

// Load from address R0 = 200.
1001_0000_0000_0001 // SUBI R0, 1;	R0 = 200
0100_0101_0000_0000 // LOAD R5, R0;     R5 = 3 
0110_0000_0000_0001 // ADDUI R0, 1;	R0 = 201
0100_0100_0000_0000 // LOAD R4, R0;     R4 = 5 

1101_0000_0111_0100 // MOVI R0, 116;	R0 = 116

0000_0101_1011_0100 // CMP R5, R4;	Flags [00001]
0100_1010_1100_0000 // JCond R0; 	IF LOWER THAN (L = 0 && Z = 0), Jump to address 116

@74
1101_0111_0000_0111 // MOVI R7, 7;	R7 = 7
1101_1000_0000_1000 // MOVI R8, 8;	R7 = 8
1101_1001_0000_0000 // MOVI R9, 0;	R9 = 0
1101_1010_0000_0000 // MOVI R10, 0;	R10 = 0

0101_1001_0000_0001 // ADDI R9, 1;	// Increment R9
0000_1010_0101_1000 // ADDI R10, R8;	// Sum R10
0000_1001_1011_0111 // CMP R9, R7;
1100_0001_1111_1101 // BCond -3; 	IF NOT EQUAL (Z = 0), Displace -3

// R00 = 116
// R01 = -497
// R02 = 252
// R03 = 90
// R04 = 3
// R05 = 5
// R06 = 0
// R07 = 7
// R08 = 8
// R09 = 7
// R10 = 56
// R11 = 0
// R12 = 0
// R13 = 0
// R14 = 0
// R15 = 0


@320 // Address 800.
0000_0000_1111_1010    // Address 800.  Value = 250.
0000_0000_1111_1100    // Address 801.  Value = 252.
0000_0000_1111_1110    // Address 802.  Value = 254.
0000_0001_0000_0000    // Address 803.  Value = 256.
0000_0001_0000_0010    // Address 804.  Value = 258.
0000_0001_0000_0100    // Address 805.  Value = 260.
0000_0001_0000_0110    // Address 806.  Value = 262.
0000_0001_0000_1000    // Address 807.  Value = 264.
0000_0001_0000_1010    // Address 808.  Value = 266.
0000_0001_0000_1100    // Address 809.  Value = 268.
0000_0001_0000_1110    // Address 810.  Value = 270.
0000_0001_0001_0000    // Address 811.  Value = 272.
0000_0001_0001_0010    // Address 812.  Value = 274.
0000_0001_0001_0100    // Address 813.  Value = 276.
0000_0001_0001_0110    // Address 814.  Value = 278.